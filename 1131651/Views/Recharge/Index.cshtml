@using X.PagedList
@using X.PagedList.Mvc.Core

@model IPagedList<_1131651.ViewModels.RechargeRecordViewModel>

@{
    ViewData["Title"] = "個人儲值記錄";

    bool isPreview = ViewBag.IsPreview == true;

    string themeCode = ViewBag.ThemeCode ?? "blue";

    if (isPreview)
    {
        Layout = null;
    }
}

<div class="theme-root theme-@themeCode @(isPreview ? "preview-mode" : "")">

    <div class="navbar-fixed">

        <div class="nav-user">
            @ViewBag.UserName
        </div>

        <div class="nav-title">
            儲值記錄系統
        </div>

        <div class="nav-right">

            <div class="member-center">
                <span class="member-link">會員中心</span>

                <div class="member-menu">
                    <a asp-controller="Recharge" asp-action="Theme">
                        更改主題
                    </a>

                    <a asp-controller="Account"  asp-action="MemberCenter">
                        會員中心
                    </a>
                </div>
            </div>

            <a asp-controller="Account"
               asp-action="Logout"
               class="btn btn-primary nav-logout"
               onclick="return confirmLogout();">
                登出
            </a>

        </div>

    </div>

    @if (TempData["LoginMessage"] != null && !isPreview)
    {
        <script>
            window.onload = function () {
                alert(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["LoginMessage"])));
            };
        </script>
    }

    <div class="page-content">

        <div class="top-actions">
            <a asp-controller="Recharge" asp-action="Create" class="btn btn-primary">
                新增記錄
            </a>

            <form asp-action="Index" method="get" class="search-form">
                <input type="text"
                       name="keyword"
                       value="@ViewBag.Keyword"
                       placeholder="輸入卡池關鍵字"
                       class="search-input" />

                <input type="hidden"
                       name="sortType"
                       value="@ViewBag.SortType" />

                <button type="submit" class="btn btn-secondary">
                    查詢
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    返回全部
                </a>
            </form>
        </div>

        <div id="floatingTotalAmount">
            <div class="total-title">累計儲值金額</div>
            <div class="total-line"></div>
            <div class="total-number">@ViewBag.TotalAmount 元</div>
        </div>

        <hr />

        <div class="switch-buttons">
            <button type="button" class="btn btn-outline-primary" onclick="showHistory()">
                歷史記錄
            </button>

            <button type="button" class="btn btn-outline-danger" onclick="showAnalysis()">
                會員儲值分析
            </button>
        </div>

        <div id="historySection">

            <div class="history-header">
                <h2 class="history-title">歷史記錄</h2>

                <form asp-action="Index" method="get" class="sort-form">
                    <input type="hidden"
                           name="keyword"
                           value="@ViewBag.Keyword" />

                    <span class="sort-label">排列順序：</span>

                    <select name="sortType"
                            class="sort-select"
                            onchange="this.form.submit()">

                        <option value="newest"
                                selected="@(ViewBag.SortType == "newest" || ViewBag.SortType == null)">
                            ▽ 最新
                        </option>

                        <option value="oldest"
                                selected="@(ViewBag.SortType == "oldest")">
                            △ 最新
                        </option>

                        <option value="high"
                                selected="@(ViewBag.SortType == "high")">
                            ▽ 金額
                        </option>

                        <option value="low"
                                selected="@(ViewBag.SortType == "low")">
                            △ 金額
                        </option>

                    </select>
                </form>
            </div>

            @if (!Model.Any())
            {
                <p class="no-data">目前沒有符合的儲值記錄</p>
            }

            @foreach (var item in Model)
            {
                <div class="record-wrapper">
                    <div class="record-card">
                        <div class="record-header">
                            <div>
                                <h4>@item.PoolName</h4>
                                <p>類型：@item.PoolTypeName</p>
                            </div>

                            <div>
                                <a asp-action="Edit" asp-route-id="@item.RecordId" class="btn btn-warning">
                                    修改記錄
                                </a>
                            </div>
                        </div>

                        <p>購買內容：</p>

                        @if (item.Details.Count > 0)
                        {
                            <ul>
                                @foreach (var detail in item.Details)
                                {
                                    <li>
                                        @detail.PackageName × @detail.Quantity
                                        （@detail.UnitPrice 元，小計 @detail.SubTotal 元）
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>尚無禮包明細</p>
                        }

                        <div class="record-amount">
                            <strong>儲值金額：@item.TotalAmount 元</strong>
                        </div>
                    </div>

                    <a asp-action="Delete"
                       asp-route-id="@item.RecordId"
                       class="btn btn-danger"
                       onclick="return confirmDelete();">
                        刪除紀錄
                    </a>
                </div>
            }
            @if (Model.PageCount > 1)
            {
                <div class="pagination-area">
                    @Html.PagedListPager(
                             Model,
                             page => Url.Action("Index", new
                             {
                                 page,
                                 keyword = ViewBag.Keyword,
                                 sortType = ViewBag.SortType
                             })
                             )
                </div>
            }
        </div>

        <div id="analysisSection" style="display:none;">

            <h2 class="analysis-title">會員儲值分析</h2>

            @if (ViewBag.TypeStats != null && ViewBag.TypeStats.Count > 0)
            {
                <div class="analysis-box">
                    @foreach (var item in ViewBag.TypeStats)
                    {
                        var percent = ViewBag.MaxTypeAmount == 0
                        ? 0
                        : (item.TotalAmount * 100 / ViewBag.MaxTypeAmount);

                        <div class="analysis-row">
                            <div class="analysis-name">@item.PoolTypeName</div>

                            <div class="bar-area">
                                <div class="bar-fill" style="width:@percent%"></div>
                            </div>

                            <div class="analysis-amount">@item.TotalAmount 元</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="no-data">目前尚無儲值資料</p>
            }

        </div>

    </div>
    <div class="page-footer">
        <div>
            <div>design by: 1131651</div>
            <div>禮包資料參考：戀與深空儲值中心</div>
        </div>
    </div>
</div>
@if (isPreview)
{
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" />
}
<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
    }

    .container,
    main {
        max-width: none !important;
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }
    .navbar-fixed {
        color: var(--navbar-text-color);
    }

        .navbar-fixed .member-link,
        .navbar-fixed .nav-user,
        .navbar-fixed .nav-title {
            color: var(--navbar-text-color);
        }

    .page-footer {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 70px;
        background-color: var(--navbar-color);
        color: var(--navbar-text-color);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1.5;
        font-size: 13px;
        font-weight: 500;
        box-shadow: 0 -4px 14px rgba(0,0,0,0.12);
        z-index: 9999;
    }
    .sort-label,
    .history-title,
    .analysis-title {
        color: var(--text-color);
    }

    .total-title {
        color: var(--card-text-color);
    }

    .btn-warning,
    .btn-secondary {
        color: #2a2222 !important;
    }

    .btn-primary,
    .btn-danger,
    .btn-outline-primary,
    .btn-outline-danger {
        color: white !important;
    }
   

    .theme-root {
        width: 100%;
        min-height: 100vh;
        padding-top: 95px;
        background-color: var(--background-color);
        color: var(--text-color);
        overflow-x: hidden;
    }

    .preview-mode {
        padding-top: 72px;
    }

    .navbar-fixed {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 72px;
        background: var(--navbar-color);
        color: var(--navbar-text-color);
        border-bottom: 1px solid rgba(0,0,0,0.12);
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
        z-index: 2000;
    }

    .nav-user {
        width: 220px;
        font-size: 22px;
        font-weight: bold;
    }

    .nav-title {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        font-size: 26px;
        font-weight: bold;
    }

    .nav-right {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .member-center {
        position: relative;
        padding: 22px 0;
    }

    .member-link {
        font-size: 18px;
        font-weight: bold;
        text-decoration: underline;
        cursor: pointer;
        transition: all 0.18s ease;
    }

        .member-link:hover {
            color: var(--button-primary);
        }

    .member-menu {
        display: none;
        position: absolute;
        top: 64px;
        right: 0;
        width: 180px;
        background: rgba(255, 255, 255, 0.82);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.12);
        border-radius: 12px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.18);
        padding: 10px 0;
        z-index: 2500;
    }

    .member-center:hover .member-menu {
        display: block;
    }

    .member-menu a {
        display: block;
        padding: 12px 18px;
        color: var(--card-text-color);
        text-decoration: none;
        font-size: 16px;
        transition: all 0.18s ease;
    }

        .member-menu a:hover {
            background-color: var(--background-color);
            color: var(--button-primary);
            transform: scale(1.03);
        }

    .nav-logout {
        width: 100px;
        font-size: 18px;
        font-weight: bold;
    }

    .page-content {
        margin-top: 20px;
        padding-bottom: 120px;
    }

    .top-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 25px;
        margin-bottom: 40px;
    }

    .search-form {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .search-input {
        width: 280px;
        padding: 8px 12px;
        border: 1px solid #bbb;
        border-radius: 6px;
        background-color: var(--card-color);
        color: var(--text-color);
    }

    .btn {
        transition: all 0.18s ease;
    }

        .btn:hover {
            transform: scale(1.06);
            box-shadow: 0 3px 8px rgba(0,0,0,0.18);
        }

    .btn-primary,
    .btn-outline-primary {
        background-color: var(--button-primary) !important;
        border-color: var(--button-primary) !important;
        color: white !important;
    }

    .btn-danger,
    .btn-outline-danger {
        background-color: var(--button-danger) !important;
        border-color: var(--button-danger) !important;
        color: white !important;
    }

    .btn-secondary,
    .btn-warning {
        background-color: var(--button-warning) !important;
        border-color: var(--button-warning) !important;
        color: var(--text-color) !important;
    }

    .btn-outline-secondary {
        background-color: var(--card-color) !important;
        border-color: var(--text-color) !important;
        color: var(--text-color) !important;
    }

    #floatingTotalAmount {
        position: fixed;
        right: 25px;
        top: 95px;
        width: 260px;
        background: var(--card-color);
        border: 1px solid rgba(255,255,255,0.4);
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 8px 24px rgba(0,0,0,0.18);
        z-index: 999;
        transition: all 0.22s ease;
    }

        #floatingTotalAmount:hover {
            transform: scale(1.05);
            box-shadow: 0 12px 28px rgba(0,0,0,0.24);
        }

    .total-title {
        font-size: 22px;
        font-weight: bold;
    }

    .total-line {
        border-top: 1px solid rgba(0,0,0,0.25);
        margin: 12px 0;
    }

    .total-number {
        font-size: 28px;
        font-weight: bold;
        color: var(--button-danger);
    }

    .switch-buttons {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 35px 0;
    }

    .history-header {
        width: 80%;
        margin: 35px auto 25px auto;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .history-title {
        margin: 0;
        text-align: center;
    }

    .sort-form {
        position: absolute;
        right: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sort-label {
        font-size: 18px;
        font-weight: bold;
    }

    .sort-select {
        width: 180px;
        height: 42px;
        border: 1px solid #bbb;
        border-radius: 8px;
        padding: 0 10px;
        font-size: 16px;
        transition: all 0.18s ease;
        background-color: var(--card-color);
        color: var(--text-color);
    }

        .sort-select:hover {
            transform: scale(1.03);
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }

    .record-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 18px;
        margin-bottom: 30px;
    }

    .record-card {
        border: 2px solid var(--text-color);
        padding: 20px;
        width: 80%;
        background-color: var(--card-color);
        color: var(--card-text-color);
    }

    .record-header {
        display: flex;
        justify-content: space-between;
    }

    .record-amount {
        text-align: right;
    }

    .analysis-title {
        text-align: center;
        margin: 35px 0 25px 0;
    }

    .analysis-box {
        width: 80%;
        margin: 30px auto;
        border: 2px solid var(--text-color);
        border-radius: 12px;
        padding: 30px;
        background-color: var(--card-color);
        color: var(--card-text-color);
    }

    .analysis-row {
        display: grid;
        grid-template-columns: 180px 1fr 120px;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .analysis-name {
        font-size: 18px;
        font-weight: bold;
    }

    .bar-area {
        height: 28px;
        border: 1px solid #bbb;
        border-radius: 20px;
        overflow: hidden;
        background-color: rgba(255,255,255,0.55);
    }

    .bar-fill {
        height: 100%;
        background-color: var(--button-primary);
        border-radius: 20px;
    }

    .analysis-amount {
        font-size: 18px;
        font-weight: bold;
        color: var(--button-danger);
        text-align: right;
    }

    .no-data {
        text-align: center;
        font-size: 20px;
        color: var(--text-color);
        margin-top: 30px;
    }

    .pagination-area {
        margin-top: 35px;
        margin-bottom: 35px;
        display: flex;
        justify-content: center;
    }

    .pagination {
        display: flex;
        gap: 8px;
        list-style: none;
        padding-left: 0;
    }

        .pagination li a,
        .pagination li span {
            display: inline-block;
            padding: 9px 15px;
            border-radius: 10px;
            text-decoration: none;
            background-color: var(--card-color);
            color: var(--text-color);
            font-weight: bold;
            box-shadow: 0 2px 6px rgba(0,0,0,0.12);
        }

        .pagination .active span {
            background-color: var(--button-primary);
            color: white;
        }
</style>

<script>
    function confirmDelete() {
        let result = confirm("確定要刪除這筆儲值紀錄嗎？");

        if (result) {
            alert("已刪除儲值紀錄");
            return true;
        }

        return false;
    }

    function confirmLogout() {
        let result = confirm("確定要登出嗎？");

        if (result) {
            alert("已登出");
            return true;
        }

        return false;
    }

    function showHistory() {
        document.getElementById("historySection").style.display = "block";
        document.getElementById("analysisSection").style.display = "none";
    }

    function showAnalysis() {
        document.getElementById("historySection").style.display = "none";
        document.getElementById("analysisSection").style.display = "block";
    }
</script>