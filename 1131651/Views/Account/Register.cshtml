@model _1131651.Models.User

@{
    ViewData["Title"] = "會員註冊";
}

<div class="register-root">

    <div class="register-navbar">

        <div class="register-title-nav">
            儲值記錄系統
        </div>

    </div>

    <div class="register-content">

        <div class="register-box">

            <h2 class="register-title">
                會員註冊
            </h2>

            <form asp-action="Register" method="post">

                @if (ViewBag.Message != null)
                {
                    <p class="error-message">@ViewBag.Message</p>
                }

                <div class="input-row">

                    <label>帳號</label>

                    <input asp-for="Account"
                           class="form-control"
                           placeholder="請輸入帳號" />

                </div>

                <div class="input-row">

                    <label>密碼</label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="請輸入密碼" />

                </div>

                <div class="input-row">

                    <label>名稱</label>

                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="請輸入使用者名稱" />

                </div>

                <div class="demo-account">

                    測試重複註冊阻擋：
                    </br>
                    帳號：user1　
                </div>

                <div class="bottom-actions">

                    <button type="submit"
                            class="btn register-btn">

                        註冊

                    </button>

                    <div class="login-link">

                        已經有帳號？

                        <a asp-controller="Account"
                           asp-action="Login">

                            回登入

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>

</div>
<div class="page-footer">
    <div>
        <div>design by: 1131651</div>
        <div>禮包資料參考：戀與深空儲值中心</div>
    </div>
</div>
<style>

    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
    }

    .container,
    main {
        max-width: none !important;
        width: 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
    }

    .register-root {
        min-height: 100vh;
        padding-top: 72px;
        padding-bottom: 90px;
        background-color: #eef6ff;
        color: #3d4b63;
    }

    .register-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 72px;
        background-color: #5d7fae;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0,0,0,0.12);
        z-index: 9999;
    }

    .register-title-nav {
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .register-content {
        min-height: calc(100vh - 158px);
        padding-top: 55px;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    }

    .register-box {
        width: 760px;
        background-color: white;
        border: 2px solid #3d4b63;
        border-radius: 20px;
        padding: 45px 70px 55px 70px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.14);
    }

    .register-title {
        text-align: center;
        margin-bottom: 45px;
        font-size: 42px;
        font-weight: bold;
    }

    .page-footer {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 70px;
        background-color: #5d7fae;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1.5;
        font-size: 13px;
        font-weight: 500;
        box-shadow: 0 -4px 14px rgba(0,0,0,0.12);
        z-index: 9999;
    }
    .input-row {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 35px;
    }

        .input-row label {
            width: 90px;
            font-size: 24px;
            font-weight: bold;
            margin-right: 20px;
            text-align: right;
        }

        .input-row .form-control {
            width: 380px;
            height: 52px;
            font-size: 20px;
            border: 2px solid #3d4b63;
            border-radius: 8px;
            text-align: center;
        }

    .demo-account {
        text-align: center;
        margin-top: 10px;
        margin-bottom: 15px;
        font-size: 17px;
        color: #6f7c92;
        background-color: rgba(255,255,255,0.55);
        border-radius: 12px;
        padding: 14px;
        line-height: 1.8;
    }

    .bottom-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 30px;
        margin-top: 45px;
    }

    .register-btn {
        width: 140px;
        height: 52px;
        background-color: #7eaee7;
        border: none;
        color: white;
        font-size: 22px;
        font-weight: bold;
        border-radius: 10px;
        transition: all 0.18s ease;
    }

        .register-btn:hover {
            transform: scale(1.06);
            box-shadow: 0 4px 10px rgba(0,0,0,0.18);
            background-color: #5d7fae;
            color: white;
        }

    .login-link {
        font-size: 18px;
    }

        .login-link a {
            text-decoration: underline;
            font-weight: bold;
            color: #5d7fae;
        }

            .login-link a:hover {
                opacity: 0.75;
            }

    .error-message {
        color: #d88a95;
        text-align: center;
        font-size: 18px;
        margin-bottom: 25px;
        font-weight: bold;
    }

</style>