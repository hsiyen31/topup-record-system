@model _1131651.Models.User

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/theme.css" />

@{
    Layout = null;

    ViewData["Title"] = "會員資料修改";

    string themeCode = ViewBag.ThemeCode ?? "blue";
}

<div class="theme-root theme-@themeCode">

    <div class="page-navbar">
        <div class="page-user">@ViewBag.UserName</div>

        <div class="page-title">會員資料修改</div>

        <a asp-controller="Recharge"
           asp-action="Index"
           class="back-btn">
            返回
        </a>
    </div>

    <div class="member-content">

        <div class="member-box">

            <form asp-action="MemberCenter" method="post">

                <input type="hidden" asp-for="UserId" />

                @if (ViewBag.Message != null)
                {
                    <p class="error-message">@ViewBag.Message</p>
                }

                @if (TempData["MemberMessage"] != null)
                {
                    <p class="success-message">@TempData["MemberMessage"]</p>
                }

                <div class="input-row">
                    <label>帳號</label>

                    <input asp-for="Account"
                           class="form-control"
                           placeholder="請輸入帳號" />
                </div>

                <div class="input-row">
                    <label>密碼</label>

                    <input asp-for="Password"
                           type="text"
                           class="form-control"
                           value="@Model.Password"
                           placeholder="請輸入密碼" />
                </div>

                <div class="input-row">
                    <label>名稱</label>

                    <input asp-for="UserName"
                           class="form-control"
                           placeholder="請輸入使用者名稱" />
                </div>

                <div class="button-area">
                    <button type="submit" class="btn save-btn">
                        儲存修改
                    </button>
                </div>

            </form>
           
        </div>
        <div class="danger-zone">

            <h4>危險操作</h4>
            <p>
                註銷會員後，您的所有資料將永久刪除，且無法復原。
            </p>

            <form asp-action="DeleteAccount"
                  method="post"
                  onsubmit="return confirmDeleteAccount();">

                <button type="submit" class="btn delete-account-btn">
                    註銷會員
                </button>

            </form>

        </div>
    </div>

    <div class="page-footer">
        <div>
            <div>design by: 1131651</div>
            <div>禮包資料參考：戀與深空儲值中心</div>
        </div>
    </div>

</div>

<style>
    html,
    body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        overflow-x: hidden;
    }

    .theme-root {
        width: 100%;
        min-height: 100vh;
        padding-top: 72px;
        padding-bottom: 100px;
        background-color: var(--background-color);
        color: var(--text-color);
        overflow-x: hidden;
    }

    .page-navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 72px;
        background-color: var(--navbar-color);
        color: var(--navbar-text-color);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 14px rgba(0,0,0,0.10);
        z-index: 9999;
    }

    .page-user {
        position: absolute;
        left: 35px;
        font-size: 22px;
        font-weight: bold;
    }

    .page-title {
        font-size: 28px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    .back-btn {
        position: absolute;
        right: 35px;
        text-decoration: none;
        background-color: var(--button-primary);
        color: white;
        padding: 10px 24px;
        border-radius: 10px;
        font-weight: bold;
        border: none;
        transition: all 0.18s ease;
    }

        .back-btn:hover {
            transform: scale(1.05);
            filter: brightness(0.95);
            color: white;
        }

    .member-content {
        min-height: calc(100vh - 172px);
        display: flex;
        flex-direction: column;
        align-items: center;
        padding-top: 55px;
        gap: 22px;
    }

    .member-box {
        width: 760px;
        background-color: var(--card-color);
        color: var(--card-text-color);
        border: 2px solid rgba(0,0,0,0.18);
        border-radius: 20px;
        padding: 50px 70px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.14);
    }

    .input-row {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 35px;
    }

        .input-row label {
            width: 90px;
            font-size: 24px;
            font-weight: bold;
            margin-right: 20px;
            text-align: right;
        }

        .input-row .form-control {
            width: 380px;
            height: 52px;
            font-size: 20px;
            border: 2px solid var(--text-color);
            border-radius: 8px;
            background-color: var(--card-color);
            color: var(--card-text-color);
            text-align: center;
        }

    .button-area {
        text-align: center;
        margin-top: 40px;
    }

    .save-btn {
        width: 160px;
        height: 52px;
        background-color: var(--button-primary);
        border: none;
        color: white;
        font-size: 22px;
        font-weight: bold;
        border-radius: 10px;
        transition: all 0.18s ease;
    }

        .save-btn:hover {
            transform: scale(1.06);
            box-shadow: 0 4px 10px rgba(0,0,0,0.18);
            color: white;
        }

    .danger-zone {
        width: 760px;
        margin: 0 auto;
        padding: 28px 32px;
        border: 2px solid var(--button-danger);
        border-radius: 16px;
        background-color: var(--card-color);
        color: var(--card-text-color);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
        text-align: center;
    }

        .danger-zone h4 {
            color: var(--button-danger);
            font-weight: bold;
            margin-bottom: 15px;
        }

        .danger-zone p {
            font-size: 17px;
            line-height: 1.8;
            margin-bottom: 22px;
        }

    .delete-account-btn {
        width: 160px;
        height: 48px;
        background-color: var(--button-danger);
        border: none;
        color: white;
        font-size: 20px;
        font-weight: bold;
        border-radius: 10px;
        transition: all 0.18s ease;
    }

        .delete-account-btn:hover {
            transform: scale(1.06);
            box-shadow: 0 4px 10px rgba(0,0,0,0.18);
            color: white;
        }

    .error-message {
        color: var(--button-danger);
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .success-message {
        color: var(--button-primary);
        text-align: center;
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .page-footer {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        height: 70px;
        background-color: var(--navbar-color);
        color: var(--navbar-text-color);
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        line-height: 1.5;
        font-size: 13px;
        font-weight: 500;
        box-shadow: 0 -4px 14px rgba(0,0,0,0.12);
        z-index: 9999;
    }
</style>

<script>
    function confirmDeleteAccount() {
        return confirm(
            "提醒您：\n\n註銷會員後，您的所有資料將永久刪除，且無法復原。\n\n是否確定要註銷會員？"
        );
    }
</script>